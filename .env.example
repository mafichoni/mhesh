# ─── Core ───────────────────────────────────────────────────────────
ENV=production
DATABASE_URL=postgresql+asyncpg://mhesh:mhesh@postgres:5432/mhesh
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
CORS_ORIGINS=https://mhesh.app,https://www.mhesh.app

# ─── R2 storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mafichoni
R2_PUBLIC_BASE_URL=

# ─── WhatsApp / Email ───────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
EMAIL_FROM=Mhesh <no-reply@mhesh.app>

# ─── M-Pesa Daraja (STK) ────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.mafichoni.co.ke/api/payments/mpesa/callback?secret=CHANGE_ME
MPESA_CALLBACK_SECRET=CHANGE_ME

# ─── M-Pesa B2C (escrow release) ────────────────────────────────────
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://api.mafichoni.co.ke/api/payments/mpesa/b2c/result?secret=CHANGE_ME
MPESA_B2C_QUEUE_URL=https://api.mafichoni.co.ke/api/payments/mpesa/b2c/timeout?secret=CHANGE_ME

# ─── GPU + LLM inference ────────────────────────────────────────────
WAN_INFERENCE_URL=
WAN_INFERENCE_TOKEN=
LLM_INFERENCE_URL=
LLM_INFERENCE_TOKEN=

# ─── Mhesh ──────────────────────────────────────────────────────────
MHESH_PUBLIC_URL=https://mhesh.app
MHESH_ODPC_REGISTERED=false
MHESH_BLACKOUT_START=2027-08-05T00:00:00+03:00
MHESH_BLACKOUT_END=2027-08-11T00:00:00+03:00
MHESH_VERIFY_KES=1
MHESH_IMAGE_COST_KES=200
MHESH_ESCROW_FEE_PCT=0.03
MHESH_PLATFORM_FEE_PCT=0.02
MHESH_PARTNER_REFERRAL_PCT=0.12
MHESH_DAILY_GEN_LIMIT=20
MHESH_DAILY_PROFILE_UPDATE_LIMIT=5
MHESH_DAILY_TASK_APPLY_LIMIT=10
# Tier prices are not in the spec — subscriptions return 503 until set.
MHESH_VERIFIED_TIER_KES=0
MHESH_FEATURED_TIER_KES=0
MHESH_PARTNER_AUTO_ACTIVATE=false
MHESH_NAME_MATCH_THRESHOLD=80
MHESH_CRON_INTERVAL_S=21600
MHESH_BLACKOUT_CHECK_INTERVAL_S=900
